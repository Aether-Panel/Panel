{
  "logs": "/var/log/SkyPanel",
  "panel": {
    "database": {
      "dialect": "mysql",
      "url": "panel:2006@tcp(192.168.0.5:3306)/skypanel?charset=utf8mb4&parseTime=true"
    },
    "web": {
      "files": "/var/www/SkyPanel"
    },
    "gatus": {
      "enable": true
    }
  },
  "daemon": {
    "data": {
      "root": "/var/lib/SkyPanel"
    }
  },
  "docker": {
    "disallowHost": true
  }
}