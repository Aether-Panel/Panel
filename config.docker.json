{
  "logs": "/var/log/SkyPanel",
  "panel": {
    "_comment": "Para desactivar el panel y usar solo como Nodo (Daemon), cambia 'enable' a false",
    "enable": true,
    "database": {
      "dialect": "mysql",
      "url": "skypanel:CHANGE_ME@tcp(mysql:3306)/skypanel?charset=utf8mb4&parseTime=true"
    },
    "web": {
      "files": "/var/www/SkyPanel"
    }
  },
  "daemon": {
    "data": {
      "root": "/var/lib/SkyPanel"
    }
  },
  "docker": {
    "disallowHost": true
  }
}
