{
  "type": "valheim",
  "display": "Valheim Dedicated Server",
  "icon": "valheim",
  "data": {
    "cpu": {
      "type": "integer",
      "value": 100,
      "display": "CPU (100% = 1 thread)",
      "desc": "CPU allocation in threads. 100% = 1 thread, 200% = 2 threads, 1000% = 10 threads",
      "required": true,
      "userEdit": false
    },
    "disk": {
      "type": "integer",
      "value": 10240,
      "display": "Disk (MB)",
      "desc": "Disk space allocation in MB (10240 MB = 10 GB)",
      "required": true,
      "userEdit": false
    },
    "modpack": {
      "type": "string",
      "value": "",
      "display": "Modpack to run with",
      "desc": "Open https://valheim.thunderstore.io/package/denikson/BepInExPack_Valheim/ in new tab and right 'manual download' click > copy link. Paste it here if you wish to use this modpack.",
      "required": false,
      "userEdit": true
    },
    "name": {
      "type": "string",
      "value": "Valheim Server",
      "display": "Name",
      "desc": "Choose your servername.",
      "required": true,
      "userEdit": true
    },
    "password": {
      "type": "string",
      "value": "valheim",
      "display": "Password",
      "desc": "Set the server password.",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 2456,
      "display": "Port",
      "desc": "What port to bind the server to.",
      "required": true,
      "userEdit": false
    },
    "world": {
      "type": "string",
      "value": "VHWorld",
      "display": "World",
      "desc": "What worldmap name to use.",
      "required": true,
      "userEdit": true
    },
    "memory": {
      "type": "integer",
      "value": 1024,
      "display": "Memory (MB)",
      "desc": "How much memory in MB to allocate",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "steamgamedl",
      "appId": "896660"
    },
    {
      "if": "env == 'docker'",
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /SkyPanel +login anonymous +app_update 896660 +quit"
      ]
    },
    {
      "if": "modpack != ''",
      "type": "download",
      "files": [
        "${modpack}"
      ]
    },
    {
      "if": "modpack != ''",
      "type": "command",
      "commands": [
        "unzip ./denikson-BepInExPack_Valheim*.zip -d ./bepin_temp/",
        "cp -r ./bepin_temp/BepInExPack_Valheim/. ./",
        "rm -r ./bepin_temp"
      ]
    },
    {
      "type": "command",
      "commands": [
        "chmod +x valheim_server.x86_64"
      ]
    }
  ],
  "run": {
    "command": "./valheim_server.x86_64 -name ${name} -port ${port} -world ${world} -password ${password} -public 1",
    "stopCode": 2,
    "environmentVars": {
      "LD_LIBRARY_PATH": "./linux64:$LD_LIBRARY_PATH"
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64",
    "binaries": [
      "unzip"
    ]
  }
}
