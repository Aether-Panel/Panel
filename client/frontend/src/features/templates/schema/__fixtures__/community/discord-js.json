{
  "type": "discord",
  "display": "discord.js",
  "icon": "discord",
  "data": {
    "cpu": {
      "type": "integer",
      "value": 100,
      "display": "CPU (100% = 1 thread)",
      "desc": "CPU allocation in threads. 100% = 1 thread, 200% = 2 threads, 1000% = 10 threads",
      "required": true,
      "userEdit": false
    },
    "disk": {
      "type": "integer",
      "value": 10240,
      "display": "Disk (MB)",
      "desc": "Disk space allocation in MB (10240 MB = 10 GB)",
      "required": true,
      "userEdit": false
    },
    "bot-js-file": {
      "type": "string",
      "value": "bot.js",
      "display": "Main bot file",
      "desc": "The main bot file.",
      "required": true,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 1024,
      "display": "Memory (MB)",
      "desc": "How much memory in MB to allocate",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "npm i"
      ]
    }
  ],
  "run": {
    "command": "node ./${bot-js-file}",
    "stopCode": 9,
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "node"
    }
  ],
  "requirements": {
    "binaries": [
      "node",
      "npm"
    ]
  }
}
