{
  "type": "mariadb",
  "display": "MariaDB",
  "icon": "mariadb",
  "data": {
    "cpu": {
      "type": "integer",
      "value": 100,
      "display": "CPU (100% = 1 thread)",
      "desc": "CPU allocation in threads. 100% = 1 thread, 200% = 2 threads, 1000% = 10 threads",
      "required": true,
      "userEdit": false
    },
    "disk": {
      "type": "integer",
      "value": 10240,
      "display": "Disk (MB)",
      "desc": "Disk space allocation in MB (10240 MB = 10 GB)",
      "required": true,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 1024,
      "display": "Memory (MB)",
      "desc": "How much memory in MB to allocate. MariaDB uses about 200 MB with the default settings",
      "required": true,
      "userEdit": false
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IP",
      "desc": "What IP to bind the server to",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 3306,
      "display": "Port",
      "desc": "Port MariaDB listens on (TCP)",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "option",
      "value": "11.8",
      "display": "MariaDB Version",
      "desc": "MariaDB release (all LTS). Upgrades work, downgrades of existing data do not",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "10.11",
          "display": "MariaDB 10.11"
        },
        {
          "value": "11.4",
          "display": "MariaDB 11.4"
        },
        {
          "value": "11.8",
          "display": "MariaDB 11.8"
        }
      ]
    },
    "rootpassword": {
      "type": "string",
      "value": "",
      "display": "Root Password",
      "desc": "Password of the MariaDB root user. Only applied when the database is created",
      "required": true,
      "userEdit": true
    },
    "database": {
      "type": "string",
      "value": "app",
      "display": "Database",
      "desc": "Database created on first start. Leave empty to skip",
      "required": false,
      "userEdit": true
    },
    "dbuser": {
      "type": "string",
      "value": "app",
      "display": "User",
      "desc": "User created on first start with full access to that database. Leave empty to skip",
      "required": false,
      "userEdit": true
    },
    "dbpassword": {
      "type": "string",
      "value": "",
      "display": "User Password",
      "desc": "Password of that user",
      "required": true,
      "userEdit": true
    },
    "extraargs": {
      "type": "string",
      "value": "",
      "display": "Extra Server Arguments",
      "desc": "Optional. Extra command line options for the server, for example --innodb-buffer-pool-size=512M --max-connections=200",
      "required": false,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "data"
    }
  ],
  "run": {
    "command": "docker-entrypoint.sh mariadbd --datadir=/SkyPanel/data --port=${port} ${extraargs}",
    "stopCode": 15,
    "environmentVars": {
      "MARIADB_ROOT_PASSWORD": "${rootpassword}",
      "MARIADB_DATABASE": "${database}",
      "MARIADB_USER": "${dbuser}",
      "MARIADB_PASSWORD": "${dbpassword}",
      "MARIADB_AUTO_UPGRADE": "1"
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "mariadb:${version}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "mariadb:${version}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ]
}
