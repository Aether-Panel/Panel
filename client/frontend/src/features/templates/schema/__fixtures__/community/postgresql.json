{
  "type": "postgresql",
  "display": "PostgreSQL",
  "icon": "postgresql",
  "data": {
    "cpu": {
      "type": "integer",
      "value": 100,
      "display": "CPU (100% = 1 thread)",
      "desc": "CPU allocation in threads. 100% = 1 thread, 200% = 2 threads, 1000% = 10 threads",
      "required": true,
      "userEdit": false
    },
    "disk": {
      "type": "integer",
      "value": 10240,
      "display": "Disk (MB)",
      "desc": "Disk space allocation in MB (10240 MB = 10 GB)",
      "required": true,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 1024,
      "display": "Memory (MB)",
      "desc": "How much memory in MB to allocate",
      "required": true,
      "userEdit": false
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IP",
      "desc": "What IP to bind the server to",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 5432,
      "display": "Port",
      "desc": "Port PostgreSQL listens on (TCP)",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "option",
      "value": "18",
      "display": "PostgreSQL Version",
      "desc": "Major version. Existing data only starts with the major version that created it",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "15",
          "display": "PostgreSQL 15"
        },
        {
          "value": "16",
          "display": "PostgreSQL 16"
        },
        {
          "value": "17",
          "display": "PostgreSQL 17"
        },
        {
          "value": "18",
          "display": "PostgreSQL 18"
        }
      ]
    },
    "dbuser": {
      "type": "string",
      "value": "postgres",
      "display": "Superuser",
      "desc": "Name of the superuser created on first start",
      "required": true,
      "userEdit": true
    },
    "dbpassword": {
      "type": "string",
      "value": "",
      "display": "Password",
      "desc": "Password of the superuser. Only applied when the database is created",
      "required": true,
      "userEdit": true
    },
    "database": {
      "type": "string",
      "value": "app",
      "display": "Database",
      "desc": "Database created on first start. Empty means a database named like the superuser",
      "required": false,
      "userEdit": true
    },
    "extraargs": {
      "type": "string",
      "value": "",
      "display": "Extra Server Arguments",
      "desc": "Optional. Extra command line options for the server, for example -c max_connections=200 -c shared_buffers=256MB",
      "required": false,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "data"
    }
  ],
  "run": {
    "command": "docker-entrypoint.sh postgres -p ${port} ${extraargs}",
    "stopCode": 2,
    "environmentVars": {
      "PGDATA": "/SkyPanel/data",
      "POSTGRES_USER": "${dbuser}",
      "POSTGRES_PASSWORD": "${dbpassword}",
      "POSTGRES_DB": "${database}"
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "postgres:${version}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "postgres:${version}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ]
}
