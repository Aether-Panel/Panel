# Copia este archivo como .env y pon tus propias contraseñas.
# .env no se sube a git: nunca compartas las contraseñas reales.

DB_ROOT_PASSWORD=cambia-esta-contraseña-root
DB_DATABASE=skypanel
DB_USER=skypanel
DB_PASSWORD=cambia-esta-contraseña

# Interfaz en la que se publica MariaDB (puerto 3307). Por defecto solo esta máquina.
# Pon 0.0.0.0 únicamente si algo externo necesita conectarse, y protégelo con firewall.
# DB_BIND_ADDRESS=127.0.0.1
